# Copy this file to `.env` and adjust the values you need.
# Everything here is optional: each setting falls back to the default
# shown, so the project runs without a `.env` file.
# Real environment variables take precedence over `.env`.

# --- Google Cloud / BigQuery -------------------------------------------
# GCP project that owns the dataset. Also the only project the table
# allowlist will permit a query to touch.
GCP_PROJECT_ID=sql-bigquery-502206

# Dataset the agent is allowed to query.
BIGQUERY_DATASET_ID=business_insights

# Region for every BigQuery job.
BIGQUERY_LOCATION=australia-southeast1

# --- Safety limits ------------------------------------------------------
# Cost cap in bytes. A dry run over this estimate is rejected before
# execution, and the executed job also carries it as maximum_bytes_billed.
MAX_QUERY_BYTES=100000000

# Maximum rows a query may return. A LIMIT is injected or reduced to
# match, and the client also caps rows fetched.
MAX_RESULT_ROWS=100

# Wall-clock cap per query. On expiry the job is cancelled.
QUERY_TIMEOUT_SECONDS=30

# How many times the LLM may attempt to repair rejected or failed SQL.
# Set to 0 to disable the repair loop.
MAX_SQL_REPAIR_ATTEMPTS=2

# Maximum rows handed to the analysis LLM. Extra rows are truncated and
# the truncation is declared in the prompt.
MAX_ANALYSIS_ROWS=50

# --- Local LLM (Ollama) -------------------------------------------------
# Ollama server address.
OLLAMA_HOST=http://localhost:11434

# Model tag. It must already be pulled: `ollama pull gemma3:4b`.
OLLAMA_MODEL=gemma3:4b

# LLM call timeout in seconds.
OLLAMA_TIMEOUT_SECONDS=120

# 0.0 - 2.0. Low values keep SQL generation close to deterministic.
OLLAMA_TEMPERATURE=0.1

# --- Logging ------------------------------------------------------------
# Directory for the human-readable log and the structured run records.
LOG_DIRECTORY=logs

# Human-readable application log.
APPLICATION_LOG_FILE=logs/agent_run.log

# One JSON object per run, appended.
RUN_LOG_FILE=logs/runs.jsonl
